-- ========== 核心寻路函数 ==========

-- 停止移动（修复版 - 确保彻底停止）
function stopMoving()
    print("🛑 执行停止...")
    isMoving = false
    isStopped = true
    
    if moveConnection then
        moveConnection:Disconnect()
        moveConnection = nil
    end
    
    local char = player.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- 停止移动
            humanoid:MoveTo(char.HumanoidRootPart.Position)
            humanoid.WalkSpeed = 16
            humanoid.AutoRotate = true
        end
    end
    
    waypoints = {}
    currentWaypointIndex = 1
    currentTarget = nil
    targetPosition = nil
    
    print("✅ 已完全停止")
end

local function createSelectionBox(part)
    if selectionBox then
        selectionBox:Destroy()
        selectionBox = nil
    end
    if part and part.Parent then
        selectionBox = Instance.new("SelectionBox")
        selectionBox.Adornee = part
        selectionBox.Color3 = Color3.fromRGB(0, 255, 255)
        selectionBox.LineThickness = 0.05
        selectionBox.Parent = part
    end
end

-- 获取有效目标位置
local function getTargetPosition(target)
    if not target then
        return nil
    end
    
    -- 如果是 Part
    if target:IsA("BasePart") then
        return target.Position
    end
    
    -- 如果是 Model
    if target:IsA("Model") then
        local root = target:FindFirstChild("HumanoidRootPart")
        if root and root:IsA("BasePart") then
            return root.Position
        end
        for _, child in ipairs(target:GetChildren()) do
            if child:IsA("BasePart") then
                return child.Position
            end
        end
    end
    
    -- 递归查找
    for _, child in ipairs(target:GetChildren()) do
        local pos = getTargetPosition(child)
        if pos then
            return pos
        end
    end
    
    return nil
end

-- 验证目标是否有效
local function isValidTarget(target)
    if not target or not target.Parent then
        return false
    end
    
    if target:IsA("BasePart") then
        return true
    end
    
    return getTargetPosition(target) ~= nil
end

-- 计算路径
local function calculatePath(startPos, endPos)
    if not startPos or not endPos then
        return nil
    end
    
    local distance = (startPos - endPos).Magnitude
    if distance < CONFIG.WaypointRadius then
        return { endPos }
    end
    
    if distance > CONFIG.MaxDistance then
        return nil
    end
    
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentMaxSlope = 45,
        WaypointSpacing = 3,
    })
    
    local success = pcall(function()
        path:ComputeAsync(startPos, endPos)
    end)
    
    if not success or path.Status ~= Enum.PathStatus.Success then
        return { endPos }
    end
    
    local pathWaypoints = path:GetWaypoints()
    if #pathWaypoints == 0 then
        return { endPos }
    end
    
    local result = {}
    for i, wp in ipairs(pathWaypoints) do
        table.insert(result, wp.Position)
    end
    return result
end

-- 开始移动到目标（修复版）
local function moveToTarget(target)
    -- 重置停止标志
    isStopped = false
    
    -- 验证目标
    if not isValidTarget(target) then
        print("❌ 无效目标")
        return false
    end
    
    local char = player.Character
    if not char or not char.Parent then
        print("❌ 角色不存在")
        return false
    end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then
        print("❌ 找不到 Humanoid 或 RootPart")
        return false
    end
    
    -- 获取目标位置
    targetPosition = getTargetPosition(target)
    if not targetPosition then
        print("❌ 无法获取目标位置")
        return false
    end
    
    local startPos = rootPart.Position
    local distance = (startPos - targetPosition).Magnitude
    
    print(string.format("📏 距离: %.1f 单位", distance))
    
    if distance < CONFIG.ArrivalRadius then
        print("✅ 已在目标位置")
        return true
    end
    
    if distance > CONFIG.MaxDistance then
        print("⚠️ 目标太远")
        return false
    end
    
    -- 停止当前移动
    stopMoving()
    isStopped = false
    
    -- 计算路径
    local pathPoints = calculatePath(startPos, targetPosition)
    if not pathPoints or #pathPoints == 0 then
        print("❌ 无法计算路径")
        return false
    end
    
    -- 保存路径
    waypoints = pathPoints
    currentWaypointIndex = 1
    currentTarget = target
    isMoving = true
    
    print(string.format("📌 路径点数量: %d", #waypoints))
    
    -- 开始移动
    humanoid.AutoRotate = true
    humanoid.WalkSpeed = CONFIG.MoveSpeed
    
    -- 移动循环
    if moveConnection then
        moveConnection:Disconnect()
        moveConnection = nil
    end
    
    local lastCheckPos = rootPart.Position
    local stuckCounter = 0
    
    moveConnection = RunService.Heartbeat:Connect(function()
        -- 检查是否被停止
        if isStopped or not isMoving then
            if moveConnection then
                moveConnection:Disconnect()
                moveConnection = nil
            end
            return
        end
        
        -- 检查角色
        if not char.Parent or not humanoid.Parent or not rootPart.Parent then
            stopMoving()
            return
        end
        
        -- 检查目标是否还存在
        if currentTarget and not currentTarget.Parent then
            print("⚠️ 目标已消失")
            stopMoving()
            return
        end
        
        -- 检查是否卡住
        local currentPos = rootPart.Position
        if (currentPos - lastCheckPos).Magnitude < 0.5 then
            stuckCounter = stuckCounter + 1
        else
            stuckCounter = 0
        end
        lastCheckPos = currentPos
        
        -- 如果卡住超过30帧，重新计算路径
        if stuckCounter > 30 then
            print("🔄 检测到卡住，重新计算路径...")
            stuckCounter = 0
            local newPath = calculatePath(rootPart.Position, targetPosition)
            if newPath and #newPath > 0 then
                waypoints = newPath
                currentWaypointIndex = 1
            end
        end
        
        -- 移动到当前路径点
        if currentWaypointIndex <= #waypoints then
            local targetWaypoint = waypoints[currentWaypointIndex]
            local distToWaypoint = (rootPart.Position - targetWaypoint).Magnitude
            
            if distToWaypoint <= CONFIG.WaypointRadius then
                currentWaypointIndex = currentWaypointIndex + 1
                -- 更新进度条
                if gui then
                    local progress = (currentWaypointIndex / #waypoints) * 100
                    gui.ProgressBar.Size = UDim2.new(math.min(progress / 100, 1), 0, 1, 0)
                end
            else
                humanoid:MoveTo(targetWaypoint)
            end
        end
        
        -- 检查是否到达终点
        if currentWaypointIndex > #waypoints then
            local finalDist = (rootPart.Position - targetPosition).Magnitude
            
            if finalDist <= CONFIG.ArrivalRadius then
                print("✅ 到达目的地！")
                if selectionBox then
                    selectionBox.Color3 = Color3.fromRGB(0, 255, 0)
                end
                if gui then
                    gui.StatusLabel.Text = "✅ 已到达目标"
                    gui.ProgressBar.Size = UDim2.new(1, 0, 1, 0)
                end
                stopMoving()
                if selectionBox then
                    task.wait(1)
                    selectionBox:Destroy()
                    selectionBox = nil
                end
            else
                -- 继续走向最终目标
                humanoid:MoveTo(targetPosition)
            end
        end
    end)
    
    return true
end

-- ========== 点击检测 ==========

local function setupClickDetection(gui)
    local mouse = player:GetMouse()
    
    local function handleClick(target)
        if not target then
            return
        end
        
        -- 忽略自己的角色
        if target:IsDescendantOf(player.Character) then
            gui.DebugLabel.Text = "🔧 点击了自己"
            return
        end
        
        -- 忽略 GUI
        if target:IsA("GuiObject") then
            return
        end
        
        local targetName = target.Name
        local parentName = target.Parent and target.Parent.Name or "无父级"
        gui.DebugLabel.Text = string.format("🔧 点击: %s (%s)", targetName, parentName)
        
        if not isValidTarget(target) then
            gui.StatusLabel.Text = "❌ 无效目标"
            gui.DebugLabel.Text = "🔧 无效: " .. targetName
            return
        end
        
        local targetPos = getTargetPosition(target)
        if not targetPos then
            gui.StatusLabel.Text = "❌ 无法获取位置"
            return
        end
        
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - targetPos).Magnitude
            if dist > CONFIG.MaxDistance then
                gui.StatusLabel.Text = "⚠️ 太远！(" .. string.format("%.0f", dist) .. ")"
                return
            end
        end
        
        -- 高亮
        local highlightPart = target:IsA("BasePart") and target or nil
        if not highlightPart then
            for _, child in ipairs(target:GetChildren()) do
                if child:IsA("BasePart") then
                    highlightPart = child
                    break
                end
            end
        end
        createSelectionBox(highlightPart)
        
        gui.TargetLabel.Text = "📍 " .. targetName
        gui.StatusLabel.Text = "🚀 寻路中..."
        gui.ProgressBar.Size = UDim2.new(0, 0, 1, 0)
        
        print(string.format("📍 目标: %s, 位置: %s", targetName, tostring(targetPos)))
        
        local success = moveToTarget(target)
        if success then
            gui.StatusLabel.Text = "🚶 移动中..."
            gui.DebugLabel.Text = "🔧 寻路成功"
        else
            gui.StatusLabel.Text = "❌ 无法到达"
            gui.DebugLabel.Text = "🔧 寻路失败"
        end
        
        if UserInputService.VibrationEnabled then
            UserInputService:Vibrate(0.1)
        end
    end
    
    -- 鼠标点击
    mouse.Button1Down:Connect(function()
        local target = mouse.Target
        if target then
            handleClick(target)
        end
    end)
    
    -- 触摸点击
    UserInputService.TouchTap:Connect(function(touch, processed)
        if processed then
            return
        end
        
        local camera = workspace.CurrentCamera
        if not camera then
            return
        end
        
        local ray = camera:ViewportPointToRay(touch.Position.X, touch.Position.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Blacklist
        params.FilterDescendantsInstances = {player.Character}
        params.IgnoreWater = true
        
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
        if result then
            handleClick(result.Instance)
        end
    end)
end

